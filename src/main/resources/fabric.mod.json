{
	"schemaVersion": 1,
	"id": "niceclient",
	"version": "${version}",
	"name": "Nice Client",
	"description": "Nice Client – nowoczesne Mod Menu, edytowalny HUD i moduły. Dla HollyMC.PL.",
	"authors": ["Nice Client"],
	"contact": { "homepage": "https://hollymc.pl" },
	"license": "CC0-1.0",
	"icon": "assets/niceclient/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["pl.nice.client.Niceclient"],
		"client": ["pl.nice.client.client.NiceclientClient"]
	},
	"mixins": [
		"niceclient.mixins.json",
		{ "config": "niceclient.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${mc_dep}",
		"java": ">=21",
		"fabric-api": "*"
	}
}
